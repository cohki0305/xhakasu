{
  "manifest_version": 3,
  "name": "xhakasu",
  "version": "0.1.0",
  "description": "X のタイムラインから、見たいジャンル以外の投稿と攻撃的・性的な投稿を非表示にする",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://*.workers.dev/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://x.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ],
  "options_page": "options.html",
  "action": { "default_popup": "popup.html", "default_title": "xhakasu" }
}
